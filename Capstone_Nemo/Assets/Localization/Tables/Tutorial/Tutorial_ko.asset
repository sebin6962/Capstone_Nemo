--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: c3b4498ddca048c4aad90d8efe6805e2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 136950562816
    m_Localized: "\uB4DC\uB514\uC5B4..."
    m_Metadata:
      m_Items: []
  - m_Id: 137013477376
    m_Localized: "\uAC00\uAC8C \uCCAB \uB0A0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 137013477377
    m_Localized: "\uC5C4\uCCAD \uB5A8\uB9AC\uB124..."
    m_Metadata:
      m_Items: []
  - m_Id: 137013477378
    m_Localized: "\uD560\uBA38\uB2C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 137013477379
    m_Localized: "\uB4E0\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 137013477380
    m_Localized: "\uACE0\uC0DD \uB9CE\uC558\uB2E4.\n\uC81C\uBC95 \uBC88\uB4EF\uD55C
      \uAC00\uAC8C\uB97C \uCC28\uB824\uB0C8\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 137013477381
    m_Localized: "\uB9AC\uBAA8\uB378\uB9C1\uC744 \uB9E1\uAE34 \uD1A0\uB07C\uAC00
      \uC19C\uC528\uAC00 \uC88B\uAE30\uB85C \uC18C\uBB38\uB09C \uC804\uBB38\uAC00\uB77C\uB354\uB2C8,
      \uD5C8\uC5B8\uC740 \uC544\uB2C8\uC5C8\uB098\uBCF4\uAD6C\uB098.\n\uAC00\uAC8C
      \uC678\uBD80\uAC00 \uAF64 \uADFC\uC0AC\uD55C\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 137013477382
    m_Localized: "\uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC11C \uAD6C\uACBD \uD55C\uBC88
      \uC2DC\uCF1C\uC8FC\uACA0\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 137013477383
    m_Localized: "\uBC2D\uB3C4 \uC81C\uBC95 \uD130\uB97C \uC798 \uC7A1\uC558\uAD6C\uB098!\n\uB545
      \uAE30\uC6B4\uC774 \uC88B\uC544 \uBCF4\uC5EC \uB2E4\uD589\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 137013477384
    m_Localized: "\uCC38, \uC694\uC998 \uB9C8\uC744 \uC190\uB2D8\uB4E4\uC774 \uB2E8\uD638\uBC15
      \uC124\uAE30\uB97C \uADF8\uB807\uAC8C \uCC3E\uB294\uB2E4\uB354\uAD6C\uB098.\n\uBBF8\uB9AC
      \uB2E8\uD638\uBC15\uC744 \uB109\uB109\uD788 \uC218\uD655\uD574 \uB450\uC5B4\uC57C
      \uD558\uC9C0 \uC54A\uACA0\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 137013477385
    m_Localized: "\uC88B\uC544, \uC218\uD655\uAE4C\uC9C0 \uCC99\uCC99 \uD574\uB0B4\uB294
      \uAC78 \uBCF4\uB2C8 \uB9C8\uC74C\uC774 \uB193\uC774\uB294\uAD6C\uB098.\n\uD558\uC9C0\uB9CC
      \uC218\uD655\uC774 \uB05D\uC774 \uC544\uB2C8\uB780\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 137013477386
    m_Localized: "\uB2E8\uD638\uBC15\uC744 \uAC00\uB8E8\uB85C \uB9CC\uB4E4\uC5B4
      \uBC18\uC8FD\uC5D0 \uC11E\uC5B4\uC57C \uC9C4\uC815\uD55C \uB9DB\uC774 \uC6B0\uB7EC\uB098\uB294
      \uBC95\uC778\uB370,\n\uADF8 \uBC29\uBC95\uC740 \uC78A\uC9C0 \uC54A\uC558\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 137013477387
    m_Localized: "\uBC29\uC557\uAC04\uC5D0 \uAC00\uC11C \uAC00\uB8E8\uB85C \uBC14\uAFB8\uB294
      \uBC95\uB3C4 \uB2E4\uC2DC \uC775\uD790 \uACB8, \uD568\uAED8 \uAC00\uBCF4\uC790\uAFB8\uB098.\n\uBC1C\uAC78\uC74C\uC744
      \uC11C\uB458\uB7EC\uC57C\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581698748416
    m_Localized: "\uD5C8\uC5B4, \uAC00\uAC8C\uAC00 \uCC38\uC73C\uB85C \uC815\uAC08\uD558\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662976
    m_Localized: "\uD560\uBBF8 \uACC1\uC5D0\uC11C \uBC30\uC6B0\uB358 \uAC8C \uC5CA\uADF8\uC81C
      \uAC19\uC740\uB370...\n\uC5B4\uB290\uC0C8 \uC774\uB807\uAC8C \uC5B4\uC5FF\uD55C
      \uC0AC\uC7A5 \uD1A0\uB07C\uAC00 \uB418\uB2E4\uB2C8..."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662977
    m_Localized: "\uADF8\uB098\uC800\uB098, \uACE7 \uCCAB \uC190\uB2D8\uC774 \uC62C
      \uC2DC\uAC04\uC778\uB370 \uC900\uBE44\uB294 \uB2E4 \uD55C \uAC8C\uB0D0?\n\uBC30\uC6B4
      \uAC83\uC744 \uC78A\uC740 \uAC74 \uC544\uB2CC\uC9C0 \uAC71\uC815\uC774 \uB418\uB294\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662978
    m_Localized: "\uADF8\uB7FC \uC5B4\uB514, \uB124 \uC2E4\uB825\uC774 \uB179\uC2AC\uC9C0
      \uC54A\uC558\uB294\uC9C0 \uC810\uAC80\uB3C4 \uD560 \uACB8...\n\uC774 \uD560\uBBF8\uAC00
      \uB108\uC758 \uCCAB \uBC88\uC9F8 \uC190\uB2D8\uC774 \uB418\uC5B4\uBCF4\uB9C8.\n\uB098\uB97C
      \uC704\uD574 \uB5A1 \uD558\uB098 \uCA84\uC8FC\uACA0\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662979
    m_Localized: "...\uC5B4\uB514 \uBCF4\uC790, \uCCAB \uC2DC\uC791\uC73C\uB85C\uB294..."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662980
    m_Localized: "\uC6B0\uB9AC\uB098\uB77C\uC758 \uC804\uD1B5\uACFC \uC21C\uC218\uB97C
      \uC0C1\uC9D5\uD558\uB294 \uC544\uC8FC \uADC0\uD55C \uB5A1\uC774\uC790,\n\uBA65\uC300\uAC00\uB8E8\uB97C
      \uACF1\uAC8C \uCCB4\uC5D0 \uB0B4\uB824 \uCA84\uB0B4\uBA74 \uB208\uCC98\uB7FC
      \uBCF4\uC2AC\uBCF4\uC2AC\uD55C \uB9DB\uC774 \uC77C\uD488\uC778..."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662981
    m_Localized: "\uBC31\uC124\uAE30\uB85C \uB2E4\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662982
    m_Localized: "\uC790, \uBA65\uC300\uAC00\uB8E8\uB97C \uCCB4\uC5D0 \uB0B4\uB9AC\uB294
      \uAC83\uBD80\uD130 \uC2DC\uC791\uD574 \uBCF4\uAC70\uB77C.\n\uB0B4\uAC00 \uC54C\uB824\uC900
      \uBC15\uC790\uB97C \uC78A\uC9C0 \uC54A\uC558\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662983
    m_Localized: "\uC74C, \uC190\uB05D\uC758 \uAC10\uAC01\uC744 \uC78A\uC9C0 \uC54A\uC558\uAD6C\uB098.\n\uC5B4\uB514
      \uB9DB\uC744 \uC880 \uBCFC\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662984
    m_Localized: "(\uD55C\uC785 \uB9DB\uBCF4\uACE0 \uB208\uC774 \uCEE4\uC9C0\uBA70)\n...\uD5C8\uC5B4!
      \uC2E4\uB825\uC774 \uB0A0\uC774 \uAC08\uC218\uB85D \uAE4A\uC5B4\uC9C0\uB294\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662985
    m_Localized: "\uACE0\uC0DD\uD588\uB2E4.\n\uC55E\uC73C\uB85C\uB3C4 \uC885\uC885
      \uB4E4\uB7EC \uB124 \uC2E4\uB825\uC744 \uC0B4\uD544 \uD14C\uB2C8 \uAE34\uC7A5
      \uB2A6\uCD94\uC9C0 \uB9D0\uAC70\uB77C.\n\uB124 \uCCAB\uAC78\uC74C\uC744 \uC774
      \uD560\uBBF8\uAC00 \uC628 \uB9C8\uC74C\uC73C\uB85C \uC751\uC6D0\uD558\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662986
    m_Localized: "\uADF8\uB098\uC800\uB098, \uC7AC\uB8CC\uB97C \uC9C1\uC811 \uAE38\uB7EC
      \uC4F0\uACA0\uB2E4\uB354\uB2C8 \uB18D\uC0AC\uB294 \uC798 \uB418\uC5B4\uAC00\uB290\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 4308581761662987
    m_Localized: "\uBC2D\uC744 \uAC00\uAFB8\uB294 \uC815\uC131\uC774 \uACE7 \uB2E4\uACFC\uC758
      \uB9DB\uC774 \uB418\uB294 \uBC95\uC774\uB2C8, \uD55C \uBC88 \uBCF4\uB7EC \uAC00\uC790\uAFB8\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640673529856
    m_Localized: "\uAC00\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918464
    m_Localized: "\uC724\uC2AC"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918465
    m_Localized: "\uC640, \uC548\uB155\uD558\uC138\uC694!\n\uC606\uC9D1\uC5D0 \uB2E4\uACFC\uC810
      \uCC28\uB9B0 \uC0AC\uC7A5\uB2D8\uC774\uC2DC\uC8E0?\n\uC815\uB9D0 \uBC18\uAC00\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918466
    m_Localized: "(\uB9D0\uC5C6\uC774 \uACE0\uAC1C\uB97C \uAFB8\uBC85 \uC219\uC778\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918467
    m_Localized: "\uB2E8\uD638\uBC15\uC744 \uB4E4\uACE0 \uC624\uC2E0 \uAC78 \uBCF4\uB2C8
      \uAC00\uB8E8\uB85C \uBC14\uAFB8\uB7EC \uC624\uC168\uB098 \uBCF4\uB124\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918468
    m_Localized: "...(\uCC9C\uCC9C\uD788 \uC808\uAD6C \uCABD\uC744 \uAC00\uB9AC\uD0A4\uBA70)\n\uC774\uCABD\uC73C\uB85C
      \uC624\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918469
    m_Localized: "\uC800 \uCE5C\uAD6C\uAC00 \uC544\uC8FC \uC190\uC528\uAC00 \uC88B\uB2E4\uACE0
      \uD558\uB354\uAD6C\uB098.\n\uC5B4\uC11C \uC808\uAD6C \uC55E\uC73C\uB85C \uAC00\uBCF4\uB834."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918470
    m_Localized: "\uC8FC\uC2DC\uBA74, \uAC00\uB8E8\uB85C \uBC14\uAFD4, \uB4DC\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918471
    m_Localized: "\uB2E4, \uB410\uC2B5\uB2C8\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918472
    m_Localized: "\uC5B4\uB514 \uBCF4\uC790...\n\uC74C, \uC544\uC8FC \uACF1\uAC8C
      \uC798 \uAC08\uB838\uAD6C\uB098. \uC88B\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918473
    m_Localized: "\uAC00\uB78C\uC774 \uB140\uC11D\uC758 \uC190\uC528\uB294 \uD22C\uBC15\uD574\uB3C4
      \uACB0\uACFC\uBB3C\uC740 \uB298 \uBBFF\uC74C\uC9C1\uD574.\n\uC124\uAE30 \uB9CC\uB4E4\uAE30\uC5D0
      \uB531 \uC54C\uB9DE\uC740 \uC785\uC790\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918474
    m_Localized: "\uCC38. \uC774 \uBC29\uC557\uAC04\uC5D0\uC11C\uB294 \uAC00\uB8E8
      \uAC00\uACF5\uC744 \uD574\uC904 \uBFD0\uB9CC \uC544\uB2C8\uB77C,\n\uB2E4\uACFC\uB97C
      \uB9CC\uB4E4 \uB54C \uD544\uC694\uD55C \uB2E4\uC591\uD55C \uC7AC\uB8CC\uB97C
      \uD310\uB2E4\uACE0 \uD558\uB354\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918475
    m_Localized: "\uD55C\uBC88 \uC724\uC2AC\uC774\uC5D0\uAC8C\uB3C4 \uAC00\uBCF4\uC9C0
      \uC54A\uC73C\uB828?"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918476
    m_Localized: "\uB2E4\uACFC \uB9CC\uB4DC\uB294 \uB370\uC5D0\uB294 \uC5ED\uC2DC
      \uBC29\uC557\uAC04\uC5D0\uC11C \uD30C\uB294 \uAC83 \uB9CC\uD55C \uAC8C \uC5C6\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918477
    m_Localized: "\uCC39\uC300\uAC00\uB8E8, \uCF69\uAC00\uB8E8, \uC5FF\uAE30\uB984...
      \uD30C\uB294 \uAC8C \uC815\uB9D0 \uB9CE\uC740\uB370!\n\uC624\uB298\uC740 \uBB3C\uD488\uC774
      \uB4E4\uC5B4\uC624\uB294 \uB0A0\uC774 \uC544\uB2C8\uB77C\uC11C \uBCF4\uC5EC\uB4DC\uB9B4
      \uC218\uAC00 \uC5C6\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918478
    m_Localized: "\uB2E4\uC74C\uC5D0 \uD544\uC694\uD55C \uAC8C \uC788\uC73C\uC2E4
      \uB54C \uC624\uC2DC\uBA74\n\uAF2D \uCC3E\uC544\uAC00\uC2E4 \uC218 \uC788\uB3C4\uB85D
      \uB9C8\uB828\uD574\uB193\uC744\uAC8C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 4312640681918479
    m_Localized: "\uC790, \uC774\uC81C \uB2E8\uD638\uBC15\uB3C4 \uAC00\uB8E8\uB85C
      \uACF1\uAC8C \uB9CC\uB4E4\uC5C8\uC73C\uB2C8,\n\uB2E8\uD638\uBC15\uC124\uAE30\uB97C
      \uB9CC\uB4E4\uB7EC \uAC00\uAC8C\uB85C \uB3CC\uC544\uAC00\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410112
    m_Localized: "\uB18D\uC0AC \uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410113
    m_Localized: "\uAC00\uAC8C \uC544\uB798\uC758 \uBC2D\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410114
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410115
    m_Localized: "\uBC2D \uAD6C\uC5ED \uC624\uB978\uCABD\uC758 \uC528\uC557 \uC0C1\uC790\uB97C
      \uC5F4\uC5B4\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410116
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410117
    m_Localized: "\uB2E8\uD638\uBC15 \uC528\uC557 \uBD09\uD22C\uB97C \uD074\uB9AD\uD574
      \uC190\uC5D0 \uB4ED\uB2C8\uB2E4.\n\uC528\uC557\uC740 \uBB34\uD55C\uC73C\uB85C
      \uC81C\uACF5\uB429\uB2C8\uB2E4.\n[\uB2E4\uC2DC E\uD0A4\uB97C \uB20C\uB7EC \uC0C1\uC790\uB97C
      \uB2EB\uC2B5\uB2C8\uB2E4]"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410118
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410119
    m_Localized: "\uBD09\uD22C\uB97C \uB4E0 \uC0C1\uD0DC\uB85C \uBC2D\uC744 \uD074\uB9AD\uD574\n\uB2E8\uD638\uBC15
      \uC528\uC557\uC744 \uC2EC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410120
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410121
    m_Localized: "\uC528\uC557\uC744 \uC2EC\uAE30\uB97C \uC644\uB8CC\uD588\uB2E4\uBA74\n\uC0C1\uC790\uB97C
      \uB2E4\uC2DC \uC5F4\uC5B4\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410122
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410123
    m_Localized: "\uD574\uB2F9 \uC528\uC557\uC758 \uC2AC\uB86F\uC744 \uD074\uB9AD\uD558\uAC70\uB098\nSPACE\uB97C
      \uB20C\uB7EC\n\uC528\uC557\uC744 \uB418\uB3CC\uB824 \uB193\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410124
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410125
    m_Localized: "E\uD0A4\uB85C \uBB3C\uBFCC\uB9AC\uAC1C\uB97C \uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410126
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410127
    m_Localized: "\uBB3C\uBFCC\uB9AC\uAC1C\uB97C \uB4E0 \uC0C1\uD0DC\uB85C,\n\uBC2D\uC744
      \uD074\uB9AD\uD558\uBA74 \uBB3C\uC744 \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410128
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410129
    m_Localized: "\uD55C \uC528\uC557\uC5D0 \uBB3C\uC744 \uD55C \uBC88 \uC8FC\uBA74,\n3\uB2E8\uACC4\uC5D0
      \uAC78\uCCD0 \uC791\uBB3C\uC774 \uC790\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410130
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410131
    m_Localized: "\uB2E4 \uC4F4 \uBB3C\uBFCC\uB9AC\uAC1C\uB294\n\uC6D0\uB798 \uC790\uB9AC\uC5D0
      \uB3CC\uB824\uB193\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410132
    m_Localized: "\uB2E8\uD638\uBC15 \uC218\uD655\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410133
    m_Localized: "\uB2E4 \uC790\uB780 \uC791\uBB3C\uC744 \uD074\uB9AD\uD574\uC11C
      \uC218\uD655\uD569\uB2C8\uB2E4.\n\uC218\uD655\uD55C \uC791\uBB3C\uC740 \uC7AC\uACE0\uC5D0\uC11C
      \uD655\uC778 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410134
    m_Localized: "\uBC29\uC557\uAC04\uC73C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410135
    m_Localized: "\uC218\uD655\uD55C \uC791\uBB3C\uC744 \uAC00\uACF5\uD558\uAE30
      \uC704\uD574\n\uBC29\uC557\uAC04\uC73C\uB85C \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410136
    m_Localized: "\uBC31\uC124\uAE30 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410137
    m_Localized: "\uC0C1\uC790\uB97C \uC5F4\uACE0, \uBA65\uC300\uAC00\uB8E8\uB97C\n\uD074\uB9AD\uD574
      \uAEBC\uB0B4\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410138
    m_Localized: "\uBC31\uC124\uAE30 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410139
    m_Localized: "\uB2E4\uC2DC E\uD0A4\uB97C \uB204\uB974\uBA74\n\uC0C1\uC790\uB97C
      \uB2EB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410140
    m_Localized: "\uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410141
    m_Localized: "\uC81C\uC791\uB300 \uC55E\uC5D0\uC11C E\uD0A4\uB97C \uB204\uB974\uBA74\n\uC190\uC5D0
      \uB4E4\uACE0 \uC788\uB358 \uC7AC\uB8CC\uB97C\n\uD22C\uC785\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410142
    m_Localized: "\uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410143
    m_Localized: "\uC81C\uC791\uB300 \uC55E\uC5D0\uC11C SPACE\uD0A4\uB97C \uB20C\uB7EC\n\uC81C\uC791\uC744
      \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410144
    m_Localized: "\uC7AC\uB8CC \uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410145
    m_Localized: "\uC81C\uC791\uB300 \uC55E\uC5D0\uC11C \n\uB2E4\uC2DC E\uD0A4\uB97C
      \uB204\uB974\uBA74\n\uC644\uC131\uB41C \uC7AC\uB8CC\uB97C \n\uD68C\uC218 \uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410146
    m_Localized: "\uAC00\uB8E8 \uD22C\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410147
    m_Localized: "\uCCB4\uC5D0 \uCE5C \uBA65\uC300\uAC00\uB8E8\uB97C \n\uBC18\uC8FD
      \uC81C\uC791\uB300\uC5D0 \uD22C\uC785\uD569\uB2C8\uB2E4.\n\uC7AC\uB8CC\uB294
      \uD558\uB098\uC529\uB9CC \uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410148
    m_Localized: "\uBB3C \uB728\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410149
    m_Localized: "\uC2F1\uD06C\uB300\uC5D0\uC11C\uB294 \uC5B8\uC81C\uB4E0\uC9C0\n\uBB3C\uC744
      \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410150
    m_Localized: "\uBB3C \uB728\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410151
    m_Localized: "\uC2F1\uD06C\uB300 \uC55E\uC5D0\uC11C \n\uB2E4\uC2DC E\uD0A4\uB97C
      \uB204\uB974\uBA74\n\uBB3C\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410152
    m_Localized: "\uBB3C \uD22C\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410153
    m_Localized: "\uBB3C\uC744 \uD22C\uC785\uD569\uB2C8\uB2E4.\n\uC81C\uC791\uB300\uC5D0\uB294
      \uC7AC\uB8CC\uB97C \uCD1D 4\uAC1C\uAE4C\uC9C0\n\uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410154
    m_Localized: "\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410155
    m_Localized: "\uBB3C\uACFC \uBA65\uC300\uAC00\uB8E8\uB97C \uBC18\uC8FD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410156
    m_Localized: "\uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410157
    m_Localized: "\uBA65\uC300 \uBC18\uC8FD\uC744 \uC2DC\uB8E8\uC5D0 \n\uB123\uACE0
      \uCC0C\uBA74 \uBC31\uC124\uAE30\uAC00 \n\uC644\uC131\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410158
    m_Localized: "\uD310\uB9E4\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410159
    m_Localized: "\uC644\uC131\uB41C \uB2E4\uACFC\uB97C \uC190\uB2D8\uC5D0\uAC8C\n\uC81C\uACF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410160
    m_Localized: "\uB2E4\uC74C \uB2E4\uACFC \uD655\uC778\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410161
    m_Localized: "\uC774\uC81C \uB2E4\uC74C \uB2E4\uACFC\uB97C \uB9CC\uB4E4\uC5B4
      \uBD05\uC2DC\uB2E4.\n[\uB3C4\uAC10 \uD074\uB9AD]"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410162
    m_Localized: "\uB2E8\uD638\uBC15\uC124\uAE30 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410163
    m_Localized: "\uB2E8\uD638\uBC15\uC124\uAE30 \uB808\uC2DC\uD53C\uB97C \uD655\uC778\uD558\uC138\uC694.\n[\uD655\uC778
      \uD6C4 \uB3C4\uAC10 \uB2EB\uAE30]"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410164
    m_Localized: "\uB18D\uC0AC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410165
    m_Localized: "\uB2E8\uD638\uBC15\uC744 \uC218\uD655\uD558\uAE30 \uC704\uD574\n\uAC00\uAC8C
      \uBC16\uC73C\uB85C \uB098\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410166
    m_Localized: "\uBC29\uC557\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410167
    m_Localized: "\uC808\uAD6C \uCC27\uB294 \uD1A0\uB07C\uC5D0\uAC8C \uB9D0\uC744
      \uAC78\uC5B4\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410168
    m_Localized: "\uC791\uBB3C \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410169
    m_Localized: "\uC67C\uCABD \uC2AC\uB86F\uC744 \uB20C\uB7EC \uC218\uD655\uD55C
      \uC791\uBB3C\uC744 \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD55C\uBC88
      \uB354 \uB204\uB974\uBA74 \uC7AC\uACE0\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.\n[\uB2E8\uD638\uBC15
      \uD22C\uC785\uD558\uAE30]"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410170
    m_Localized: "\uAC00\uB8E8\uB85C \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410171
    m_Localized: "\uC544\uB798\uC758 \uCCB4\uD06C \uBC84\uD2BC\uC744 \uB204\uB974\uBA74\n\uD22C\uC785\uB41C
      \uC791\uBB3C\uC774 \uAC00\uB8E8\uB85C \uBCC0\uD658\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410172
    m_Localized: "\uAC00\uB8E8 \uC791\uC5C5 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410173
    m_Localized: "\uB2E8\uD638\uBC15\uAC00\uB8E8\uB97C \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4.\n[\uD31D\uC5C5
      \uB2EB\uAE30]"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410174
    m_Localized: "\uAD6C\uC785\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410175
    m_Localized: "\uACC4\uC0B0\uB300\uC758 \uC724\uC2AC\uC5D0\uAC8C \uB9D0\uC744
      \uAC78\uC5B4 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410176
    m_Localized: "\uAD6C\uC785\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4325063736410177
    m_Localized: "\uB808\uBCA8\uC774 \uC62C\uB77C \uC0C8\uB85C\uC6B4 \uB2E4\uACFC\uAC00
      \uD574\uAE08\uB418\uBA74\n\uBB3C\uD488\uC774 \uC5C5\uB370\uC774\uD2B8 \uB429\uB2C8\uB2E4.\n[\uAD6C\uB9E4
      \uCC3D \uB2EB\uAE30]"
    m_Metadata:
      m_Items: []
  - m_Id: 4330711777787904
    m_Localized: "\uC0C1\uC790 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4330711777787905
    m_Localized: "\uC0C1\uC790 \uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4330711777787906
    m_Localized: "\uC81C\uC791\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4330711777787907
    m_Localized: "\uC190\uC5D0 \uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4330711777787908
    m_Localized: "\uC7AC\uB8CC \uB123\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4330711777787909
    m_Localized: "\uBB3C \uB728\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4336456611119104
    m_Localized: "\uAC00\uAC8C \uB098\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028220334080
    m_Localized: "\uB2E8\uD638\uBC15\uC124\uAE30 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803072
    m_Localized: "\uC0C1\uC790\uB97C \uC5F4\uACE0 \uB2E8\uD638\uBC15 \uAC00\uB8E8\uB97C
      \uD074\uB9AD\uD574\n\uAEBC\uB0B4\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803073
    m_Localized: "\uB2E8\uD638\uBC15\uC124\uAE30 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803074
    m_Localized: "\uB2E4\uC2DC E\uD0A4\uB97C \uB204\uB974\uBA74\n\uC0C1\uC790\uB97C
      \uB2EB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803075
    m_Localized: "\uAC00\uB8E8 \uD22C\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803076
    m_Localized: "\uB2E8\uD638\uBC15\uAC00\uB8E8\uB294 \uCCB4\uC5D0 \uCE58\uC9C0
      \uC54A\uACE0\n\uBC18\uC8FD \uC81C\uC791\uB300\uC5D0 \uD22C\uC785\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803077
    m_Localized: "\uBB3C \uB728\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803078
    m_Localized: "\uC2F1\uD06C\uB300\uC5D0\uC11C\uB294 \uC5B8\uC81C\uB4E0\uC9C0\n\uBB3C\uC744
      \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803079
    m_Localized: "\uBB3C \uB728\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803080
    m_Localized: "\uC2F1\uD06C\uB300 \uC55E\uC5D0\uC11C\n\uB2E4\uC2DC E\uD0A4\uB97C
      \uB204\uB974\uBA74\n\uBB3C\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803081
    m_Localized: "\uBB3C \uD22C\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803082
    m_Localized: "\uBB3C\uC744 \uD22C\uC785\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803083
    m_Localized: "\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803084
    m_Localized: "\uBB3C\uACFC \uB2E8\uD638\uBC15\uAC00\uB8E8\uB97C \uBC18\uC8FD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803085
    m_Localized: "\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803086
    m_Localized: "E\uD0A4\uB97C \uB20C\uB7EC\n\uBC18\uC8FD\uC744 \uAEBC\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803087
    m_Localized: "\uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803088
    m_Localized: "\uB2E8\uD638\uBC15 \uBC18\uC8FD\uC744 \uC2DC\uB8E8\uC5D0\n\uB123\uACE0
      \uCC0C\uBA74 \uB2E8\uD638\uBC15\uC124\uAE30\uAC00\n\uC644\uC131\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803089
    m_Localized: "\uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803090
    m_Localized: "E\uD0A4\uB97C \uB20C\uB7EC\n\uB2E8\uD638\uBC15\uC124\uAE30\uB97C
      \uAEBC\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4378028316803091
    m_Localized: "\uD310\uB9E4\uD558\uAE30"
    m_Metadata:
