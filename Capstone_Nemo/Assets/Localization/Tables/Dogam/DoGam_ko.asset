  m_TableData:
  - m_Id: 1678759936000
    m_Localized: "\uBC31\uC124\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879040
    m_Localized: "\uBC31\uC124\uAE30\uB294 \uD558\uC597\uACE0 \uAE68\uB057\uD55C
      \uC0C9\uC744 \uC9C0\uB140 \uC608\uB85C\uBD80\uD130 \n\uC21C\uC218\uC640 \uBCF5\uC744
      \uC0C1\uC9D5\uD558\uB294 \uB5A1\uC73C\uB85C \uC5EC\uACA8\uC84C\uC2B5\uB2C8\uB2E4.\n\uD2B9\uD788
      \uC544\uC774\uC758 \uCCAB \uC0DD\uC77C(\uB3CC)\uC774\uB098\n\uC9D1\uC548\uC758
      \uACBD\uC0AC\uC2A4\uB7EC\uC6B4 \uB0A0\uC5D0 \uBE60\uC9C0\uC9C0 \uC54A\uACE0
      \uC62C\uB9AC\uB294\n\uADC0\uD55C \uB5A1\uC774\uB77C\uACE0 \uC54C\uB824\uC838
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879041
    m_Localized: "1. \uB9F5\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879042
    m_Localized: "2. \uCCB4 \uCE5C \uBA65\uC300\uAC00\uB8E8 \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879043
    m_Localized: "3. \uBA65\uC300\uAC00\uB8E8 \uBC18\uC8FD \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879044
    m_Localized: "\uB2E8\uD638\uBC15\uC124\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879045
    m_Localized: "\uB2E8\uD638\uBC15\uC124\uAE30\uB294 \uC124\uAE30\uC5D0 \uAC00\uC744\uCCA0
      \uC601\uC591 \uC2DD\uC7AC\uB8CC\uC778\n\uB2E8\uD638\uBC15\uC744 \uB354\uD574
      \uD48D\uBBF8\uB97C \uB192\uC778 \uB5A1\uC785\uB2C8\uB2E4.\n\uB2E8\uD638\uBC15\uC758
      \uB178\uB780\uBE5B\uC740 \uBCF5\uC744 \uC0C1\uC9D5\uD558\uC5EC,\n\uC608\uBD80\uD130
      \uD48D\uC694\uC640 \uAC74\uAC15\uC744 \uAE30\uC6D0\uD558\uB294 \uC758\uBBF8\uB85C\n\uC990\uACA8
      \uBA39\uC5C8\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879046
    m_Localized: "1. \uB2E8\uD638\uBC15\uC744 \uAC00\uB8E8\uB85C \uB9CC\uB4E4\uAE30(\uBC29\uC557\uAC04)"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879047
    m_Localized: "2. \uB2E8\uD638\uBC15 \uAC00\uB8E8 \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879048
    m_Localized: "3. \uB2E8\uD638\uBC15 \uBC18\uC8FD \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879049
    m_Localized: "\uC778\uC808\uBBF8"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879050
    m_Localized: "\uC778\uC808\uBBF8\uB294 \uCC39\uC300\uB5A1\uC744 \uCC10 \uD6C4
      \uC808\uAD6C\uB85C \uCE5C \uB4A4,\n\uBA39\uAE30 \uC88B\uAC8C \uC370\uC5B4 \uCF69\uACE0\uBB3C\uC744
      \uBB3B\uD78C \uACE0\uC18C\uD55C \uB5A1\uC785\uB2C8\uB2E4.\n\uBA3C \uC61B\uB0A0,
      \uC655\uC5D0\uAC8C \uC62C\uB838\uB358 \uCC39\uC300\uB5A1\uC774 \uC778\uC808\uBBF8\uC758\n\uAE30\uC6D0\uC774
      \uB418\uC5C8\uB2E4\uB294 \uC124\uD654\uB3C4 \uC804\uD574\uC838 \uB0B4\uB824\uC635\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879051
    m_Localized: "1. \uCC39\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879052
    m_Localized: "2. \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879053
    m_Localized: "3. \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879054
    m_Localized: "4. \uCE58\uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879055
    m_Localized: "5. \uCF69\uAC00\uB8E8 \uBB3B\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879056
    m_Localized: "\uC465\uC778\uC808\uBBF8"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879057
    m_Localized: "\uC465\uC778\uC808\uBBF8\uB294 \uBD04\uCCA0 \uC57D\uCD08\uC778
      \uC465\uC73C\uB85C \uB9CC\uB4E0 \uB5A1\uC785\uB2C8\uB2E4.\n\uC465\uC740 \uC561\uC6B4\uC744
      \uCAD3\uACE0 \uBAB8\uC744 \uB530\uB73B\uD558\uAC8C \uD55C\uB2E4 \uD558\uC5EC,\n\uBD04\uCCA0
      \uAE30\uB825 \uD68C\uBCF5\uACFC \uBD80\uC815 \uBC29\uC9C0\uC758 \uC758\uBBF8\uB85C\n\uC790\uC8FC
      \uBA39\uC5C8\uB2F5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879058
    m_Localized: "1. \uC465\uAC00\uB8E8 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879059
    m_Localized: "2. \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879060
    m_Localized: "3. \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879061
    m_Localized: "4. \uCE58\uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879062
    m_Localized: "5. \uCF69\uAC00\uB8E8 \uBB3B\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879063
    m_Localized: "\uD325\uC2DC\uB8E8\uB5A1"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879064
    m_Localized: "\uD325\uC2DC\uB8E8\uB5A1\uC740 \u2018\uC2DC\uB8E8\u2019\uB77C\uB294
      \uC804\uD1B5 \uCC1C\uD2C0\uC5D0\n\uC300\uAC00\uB8E8\uC640 \uACE0\uBB3C\uC744
      \uCF1C\uCF1C\uC774 \uB2F4\uC544 \uCA84\uB0B8 \uB5A1\uC785\uB2C8\uB2E4.\n\uC81C\uC0AC,
      \uB3CC\uC794\uCE58 \uB4F1 \uC911\uC694\uD55C \uB0A0\uC5D0\n\uC62C\uB9AC\uB294
      \uB300\uD45C\uC801\uC778 \uC758\uB840\uC6A9 \uB5A1\uC774\uAE30\uB3C4 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879065
    m_Localized: "1. \uBA65\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879066
    m_Localized: "2. \uCCB4 \uCE5C \uBA65\uC300\uAC00\uB8E8 \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879067
    m_Localized: "3. \uD325 \uC73C\uAE68\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879068
    m_Localized: "4. \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879069
    m_Localized: "\uBC14\uB78C\uB5A1"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879070
    m_Localized: "\uBC14\uB78C\uB5A1\uC740 \uB2EC\uCF64\uD55C \uD325\uC18C\uB97C
      \uB123\uC5B4 \uBC18\uB2EC \uBAA8\uC591\uC73C\uB85C\n\uBE5A\uC740 \uC804\uD1B5
      \uB5A1\uC785\uB2C8\uB2E4.\n\uB5A1 \uC0AC\uC774\uC5D0 \uBC14\uB78C\uC774 \uB4E4\uC5B4\uAC08
      \uB9CC\uD07C \uC587\uAC8C \uBE5A\uC73C\uBA70,\n\uC5B4\uB5A4 \uC9C0\uC5ED\uC5D0\uC120
      \uBC14\uB78C\uC744 \uD53C\uC9C0 \uB9D0\uB77C\uB294 \uC758\uBBF8\uB85C\n\uD63C\uB840
      \uB54C\uB3C4 \uB098\uB234\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879071
    m_Localized: "1. \uBA65\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879072
    m_Localized: "2. \uC775\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879073
    m_Localized: "3. \uD325\uC559\uAE08 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879074
    m_Localized: "4. \uBC18\uC8FD \uBE5A\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879075
    m_Localized: "5. \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879076
    m_Localized: "\uC1A1\uD3B8"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879077
    m_Localized: "\uC1A1\uD3B8\uC740 \uC194\uC78E \uC704\uC5D0 \uCC0C\uB294 \uBC18\uB2EC
      \uBAA8\uC591\uC758 \uB5A1\uC73C\uB85C,\n\uCD94\uC11D\uC5D0 \uC870\uC0C1\uC5D0\uAC8C
      \uC18C\uC6D0\uC744 \uBE44\uB294 \uB73B\uC5D0\uC11C \uBA39\uC2B5\uB2C8\uB2E4.\n\u2018\uC1A1\uD3B8\uC744
      \uC608\uC058\uAC8C \uBE5A\uC73C\uBA74\n\uC608\uC05C \uB538\uC744 \uB0B3\uB294\uB2E4\u2019\uB294
      \uC18D\uC124\uB3C4 \uC788\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879078
    m_Localized: "1. \uBA65\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879079
    m_Localized: "2. \uC775\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879080
    m_Localized: "3. \uAFC0\uAE68\uC18C \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879081
    m_Localized: "4. \uBC18\uC8FD \uBE5A\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879082
    m_Localized: "5. \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879083
    m_Localized: "\uAFC0\uB5A1"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879084
    m_Localized: "\uAFC0\uB5A1\uC740 \uC18D\uC5D0 \uB2EC\uCF64\uD55C \uAFC0\uC744
      \uB123\uACE0 \uCC10 \uCC39\uC300\uB5A1\uC73C\uB85C,\n\uC785\uC5D0\uC11C \uC0AC\uB974\uB974
      \uD130\uC9C0\uB294 \uC18C\uAC00\n\uD2B9\uC9D5\uC778 \uC804\uD1B5 \uAC04\uC2DD\uC785\uB2C8\uB2E4.\n\uC544\uC774\uC758
      \uBB34\uBCD1\uC7A5\uC218\uB97C \uAE30\uC6D0\uD558\uBA70\n\uB3CC\uC0C1\uC5D0
      \uC62C\uB9AC\uAE30\uB3C4 \uD588\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879085
    m_Localized: "1. \uCC39\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879086
    m_Localized: "2. \uC775\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879087
    m_Localized: "3. \uAFC0\uACFC \uAE68\uB97C \uC11E\uC5B4 \uAFC0\uAE68\uC18C \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879088
    m_Localized: "4. \uBC18\uC8FD \uBE5A\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879089
    m_Localized: "5. \uBC18\uC8FD \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879090
    m_Localized: "\uCC39\uC300\uB5A1"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879091
    m_Localized: "\uCC39\uC300\uB5A1\uC740 \uCC39\uC300\uAC00\uB8E8 \uBC18\uC8FD
      \uC18D\uC5D0\n\uB2E8\uD325\uC18C\uB098 \uBC24\uC18C\uB97C \uB123\uC740 \uC804\uD1B5
      \uB5A1\uC785\uB2C8\uB2E4.\n\uBA85\uC808\uC774\uB098 \uC2DC\uD5D8 \uAC19\uC774
      \uD2B9\uBCC4\uD55C \uB0A0\uC5D0\n\uBCF5\uC744 \uAE30\uC6D0\uD558\uBA70 \uBA39\uB294
      \uB5A1\uC774\uBA70,\n\u2018\uC88B\uC740 \uC77C\uB9CC \uBD99\uC73C\uB77C\u2019\uB294
      \uC758\uBBF8\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879092
    m_Localized: "1. \uCC39\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879093
    m_Localized: "2. \uC775\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879094
    m_Localized: "3. \uD325 \uC73C\uAE68\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879095
    m_Localized: "4. \uBE5A\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879096
    m_Localized: "5. \uBC00\uAC00\uB8E8 \uBB3B\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879097
    m_Localized: "\uC808\uD3B8"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879098
    m_Localized: "\uC808\uD3B8\uC740 \uCC39\uC300\uAC00\uB8E8\uB97C \uCC10 \uD6C4
      \uB0A9\uC791\uD558\uAC8C \uB20C\uB7EC\n\uBA39\uAE30 \uC88B\uC740 \uC870\uAC01\uC73C\uB85C
      \uC790\uB978 \uB5A1\uC785\uB2C8\uB2E4.\n\uACE0\uB824\uC2DC\uB300\uBD80\uD130
      \uC774\uC5B4\uC9C4 \uC804\uD1B5 \uB5A1\uC73C\uB85C, \n\uBA85\uC808\uC774\uB098
      \uC81C\uC0AC\uC0C1\uC5D0 \uC790\uC8FC \uC624\uB974\uBA70,\n\uBCF5\uC744 \uAE30\uC6D0\uD558\uB294
      \uB5A1\uC73C\uB85C \uC5EC\uACA8\uC84C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879099
    m_Localized: "1. \uBA65\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879100
    m_Localized: "2. \uC775\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879101
    m_Localized: "3. \uBB34\uB2AC\uCC0D\uAE30(\uC808\uD3B8 \uD2C0\uC744 \uB4E4\uACE0
      \uC81C\uC791 \uC2DC\uC791)"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879102
    m_Localized: "\uBB34\uC9C0\uAC1C\uB5A1"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879103
    m_Localized: "\uBB34\uC9C0\uAC1C\uB5A1\uC740 \uC0C9\uC0C9\uC758 \uBC18\uC8FD\uC744\n\uACB9\uACB9\uC774
      \uC313\uC544 \uCC10 \uB5A1\uC73C\uB85C,\n\uD654\uD569, \uD76C\uB9DD\uC758 \uC0C1\uC9D5\uC73C\uB85C
      \uC5EC\uACA8\uC9D1\uB2C8\uB2E4.\n\uB3CC\uC794\uCE58, \uACB0\uD63C\uC2DD \uB4F1
      \uCD95\uD558 \uC790\uB9AC\uC5D0 \uC790\uC8FC \uC62C\uB9AC\uBA70,\n\uBCF5\uC774
      \uC313\uC774\uAE30\uB97C \uAE30\uC6D0\uD558\uB294 \uB9C8\uC74C\uC774 \uB2F4\uACA8
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879104
    m_Localized: "1. \uB2E8\uD638\uBC15\uAC00\uB8E8 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879105
    m_Localized: "1. \uC465\uAC00\uB8E8 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879106
    m_Localized: "1. \uBC31\uB144\uCD08\uAC00\uB8E8 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879107
    m_Localized: "2. \uBA65\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879108
    m_Localized: "2. \uB2E8\uD638\uBC15\uAC00\uB8E8 \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879109
    m_Localized: "2. \uC465\uAC00\uB8E8 \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879110
    m_Localized: "2. \uBC31\uB144\uCD08\uAC00\uB8E8 \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879111
    m_Localized: "2. \uCCB4 \uCE5C \uBA65\uC300\uAC00\uB8E8 \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879112
    m_Localized: "3. \uBAA8\uB4E0 \uBC18\uC8FD \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879113
    m_Localized: "\uC0AC\uACFC\uC815\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879114
    m_Localized: "\uC0AC\uACFC\uB97C \uAECD\uC9C8\uC9F8 \uB2EC\uC774\uACE0 \uAFC0\uC5D0
      \uC878\uC5EC\n\uC800\uC7A5\uC131\uACFC \uD48D\uBBF8\uB97C \uB192\uC778 \uC804\uD1B5
      \uACFC\uC77C \uB514\uC800\uD2B8\uC785\uB2C8\uB2E4.\n\uD2B9\uD788 \uAC00\uC744\xB7\uACA8\uC6B8\uCCA0
      \uC800\uC7A5 \uAC04\uC2DD\uC73C\uB85C\n\uC0AC\uB791 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879115
    m_Localized: "1. \uC790\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879116
    m_Localized: "2. \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879117
    m_Localized: "3. \uBB3B\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879118
    m_Localized: "4. \uAC74\uC870\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879119
    m_Localized: "\uAE08\uADE4\uC815\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879120
    m_Localized: "\uAE08\uADE4\uC744 \uAFC0\uC5D0 \uC878\uC5EC \uB9CC\uB4DC\uB294
      \uC815\uACFC\uB85C,\n\uAC10\uAE30 \uC608\uBC29\uACFC \uC18C\uD654 \uAE30\uB2A5
      \uAC1C\uC120, \n\uC785 \uC548\uC744 \uAC1C\uC6B4\uD558\uAC8C \uD574\uC8FC\uB294
      \uD6A8\uB2A5\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879121
    m_Localized: "1. \uC790\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879122
    m_Localized: "2. \uC878\uC774\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879123
    m_Localized: "3. \uAC74\uC870\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879124
    m_Localized: "\uACBD\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879125
    m_Localized: "\uACBD\uB2E8\uC740 \uCC39\uC300\uAC00\uB8E8\uB97C \uB3D9\uADF8\uB797\uAC8C
      \uBE5A\uC5B4 \uC0B6\uC740 \uD6C4\n\uACE0\uBB3C\uC744 \uBB3B\uD600 \uBA39\uB294
      \uC804\uD1B5 \uAC04\uC2DD\uC785\uB2C8\uB2E4.\n\uAD81\uC911\uC5D0\uC11C\uB294
      \uADC0\uD55C \uB300\uC811\uC744 \uBC1B\uC558\uC73C\uBA70,\n\uC794\uCE58\xB7\uBA85\uC808
      \uC0C1\uCC28\uB9BC\uC5D0\uB3C4 \uC790\uC8FC \uC62C\uB790\uB358 \uB5A1\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879126
    m_Localized: "1. \uCC39\uC300\uAC00\uB8E8 \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879127
    m_Localized: "2. \uC775\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879128
    m_Localized: "3. \uBE5A\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879129
    m_Localized: "4. \uC0B6\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879130
    m_Localized: "5. \uBB3B\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879131
    m_Localized: "\uB9DD\uAC1C\uB5A1"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879132
    m_Localized: "\uCAC4\uAE43\uD55C \uB5A1 \uC548\uC5D0 \uD325\uC559\uAE08\uC744
      \uB123\uACE0\n\uD5A5\uAE0B\uD55C \uB9DD\uAC1C\uC78E\uC73C\uB85C \uC2F8\uC11C
      \uCC10 \uB5A1\uC785\uB2C8\uB2E4.\n\uC8FC\uB85C \uB2E8\uC624\uC640 \uCD94\uC11D
      \uBB34\uB835\uC5D0 \uB098\uB220\uBA39\uACE0,\n\uB9DD\uAC1C\uC78E\uC740 \uCC9C\uC5F0
      \uBC29\uBD80\uC81C \uC5ED\uD560\uB3C4 \uD55C\uB2F5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879133
    m_Localized: "1. \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879134
    m_Localized: "2. \uC775\uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879135
    m_Localized: "3. \uD325\uC559\uAE08 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879136
    m_Localized: "4. \uBE5A\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879137
    m_Localized: "5. \uCC0C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879138
    m_Localized: "\uC57D\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879139
    m_Localized: "\uC57D\uC7AC\uCC98\uB7FC \uADC0\uD558\uAC8C \uC5EC\uACA8\uC84C\uB358
      \uC57D\uACFC\uB294\n\uD55C\uAD6D \uC804\uD1B5 \uD55C\uACFC\uC758 \uAF43\uC774\uB77C\uACE0\uB3C4
      \uD569\uB2C8\uB2E4.\n\uC740\uC740\uD55C \uD5A5\uACFC \uB2EC\uCF64\uD568,\n\uBC14\uC0AD\uD558\uBA74\uC11C\uB3C4
      \uCAC0\uB4DD\uD55C \uC2DD\uAC10\uC73C\uB85C\n\uD2B9\uBCC4\uD55C \uB0A0\uC5D0
      \uBE60\uC9C0\uC9C0 \uC54A\uB294 \uB2E4\uACFC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879140
    m_Localized: "1. \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879141
    m_Localized: "2. \uBB34\uB2AC\uCC0D\uAE30(\uC57D\uACFC \uD2C0\uC744 \uB4E4\uACE0
      \uC81C\uC791 \uC2DC\uC791)"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879142
    m_Localized: "3. \uD280\uAE30\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879143
    m_Localized: "4. \uC999\uCCAD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879144
    m_Localized: "\uAC1C\uC131\uC8FC\uC545"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879145
    m_Localized: "\uAC1C\uC131 \uC9C0\uBC29\uC5D0\uC11C \uC804\uD574\uC9C4 \uB465\uADFC
      \uD280\uAE40 \uACFC\uC790\n\uB77C\uB294 \uB73B\uC73C\uB85C,\n\uB2EC\uCF64\uD558\uACE0
      \uC0C9\uB2E4\uB978 \uC2DD\uAC10\uC73C\uB85C \uC0AC\uB791 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879146
    m_Localized: "1. \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879147
    m_Localized: "2. \uBE5A\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879148
    m_Localized: "3. \uD280\uAE30\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879149
    m_Localized: "4. \uC999\uCCAD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879150
    m_Localized: "\uC0B0\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879151
    m_Localized: "'\uD769\uC5B4\uC9C4 \uC74C\uC2DD'\uC774\uB77C\uB294 \uB73B\uC73C\uB85C,\n\uCC30\uB5A1
      \uBC18\uC8FD\uC744 \uC587\uAC8C \uC370\uC5B4 \uB9D0\uB9B0 \uB4A4\n\uAE30\uB984\uC5D0
      \uD280\uAE30\uACE0 \uC870\uCCAD\uACFC \uD280\uBC25\uC744 \uC785\uD78C \uD55C\uACFC\uC785\uB2C8\uB2E4.\n\uBC14\uC0AD\uD55C
      \uC2DD\uAC10\uACFC \uACE0\uC6B4 \uC0C9\uAC10\uC73C\uB85C\n\uC804\uD1B5\uCC28\uC640
      \uD568\uAED8 \uC990\uAE30\uB358 \uB300\uD45C \uAC04\uC2DD\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879152
    m_Localized: "1. \uBC18\uC8FD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879153
    m_Localized: "2. \uD280\uAE30\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879154
    m_Localized: "3. \uC999\uCCAD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879155
    m_Localized: "4. \uBB3B\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879156
    m_Localized: "\uC2DD\uD61C"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879157
    m_Localized: "\uC2DD\uD61C\uB294 \uBC25\uC54C\uC744 \uB744\uC6CC \uB9CC\uB4E0
      \uBC1C\uD6A8 \uC74C\uB8CC\uB85C,\n'\uB2E8\uC220'\uC774\uB77C\uACE0\uB3C4 \uBD88\uB9BD\uB2C8\uB2E4.\n\uC870\uC120\uC2DC\uB300
      \uAD81\uC911\uC5D0\uC11C\uB3C4 \uADC0\uD55C \uC74C\uB8CC\uC600\uACE0,\n\uC18C\uD654\uB97C
      \uB3D5\uAE30 \uC704\uD574 \uB9C8\uC2DC\uAE30\uB3C4 \uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879158
    m_Localized: "1. \uCCB4 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879159
    m_Localized: "2. \uB053\uC774\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879160
    m_Localized: "\uC720\uC790\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879161
    m_Localized: "\uC720\uC790\uCC28\uB294 \uD5A5\uAE0B\uD55C \uC720\uC790\uC758
      \uAECD\uC9C8\uACFC \uACFC\uC721\uC744\n\uAFC0\uC5D0 \uC7AC\uC6CC \uC6B0\uB824\uB0B8
      \uACFC\uC77C \uCC28\uC785\uB2C8\uB2E4.\n\uAC10\uAE30 \uC608\uBC29, \uBAA9 \uAC74\uAC15\uC5D0
      \uC88B\uB2E4\uACE0 \uC54C\uB824\uC838\n\uACA8\uC6B8\uCCA0\uC5D0 \uC0AC\uB791\uBC1B\uB294
      \uAC74\uAC15 \uCC28\uC774\uAE30\uB3C4 \uD558\uB2F5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879162
    m_Localized: "1. \uC790\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879163
    m_Localized: "2. \uCCAD \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879164
    m_Localized: "3. \uCC28 \uB053\uC774\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879165
    m_Localized: "\uBAA8\uACFC\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879166
    m_Localized: "\uBAA8\uACFC\uCC28\uB294 \uD5A5\uC774 \uAC15\uD558\uACE0 \uB2E8\uB2E8\uD55C
      \uBAA8\uACFC\uB97C\n\uC124\uD0D5\uC774\uB098 \uAFC0\uC5D0 \uC808\uC5EC \uB9CC\uB4E0
      \uACFC\uC77C\uCC28\uC785\uB2C8\uB2E4.\n\uAE30\uAD00\uC9C0 \uAC74\uAC15, \uC18C\uD654
      \uCD09\uC9C4\uC5D0 \uC88B\uB2E4\uACE0 \uC54C\uB824\uC838\n\uC608\uB85C\uBD80\uD130
      \uACA8\uC6B8\uCCA0 \uC57D\uCC28\uB85C \uC990\uACA8 \uBA39\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879167
    m_Localized: "1. \uC790\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879168
    m_Localized: "2. \uCCAD \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879169
    m_Localized: "3. \uCC28 \uB053\uC774\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879170
    m_Localized: "\uC624\uBBF8\uC790\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879171
    m_Localized: "\uC624\uBBF8\uC790\uCC28\uB294 \uC2E0\uB9DB, \uB2E8\uB9DB, \uC4F4\uB9DB,
      \uC9E0\uB9DB, \uB9E4\uC6B4\uB9DB\n\uB2E4\uC12F \uAC00\uC9C0 \uB9DB\uC774 \uB09C\uB2E4\uACE0
      \uD574\uC11C\n\u2018\uC624\uBBF8\uC790\u2019\uB77C \uBD88\uB9AC\uB294 \uC5F4\uB9E4\uB85C
      \uB9CC\uB4DC\uB294 \uD55C\uBC29\uCC28\uC785\uB2C8\uB2E4.\n\uAE30\uB825\uC744
      \uBD81\uB3CB\uACE0 \uD53C\uBD80 \uBBF8\uC6A9\uC5D0\uB3C4 \uD6A8\uACFC\uAC00
      \uC788\uB2E4\uACE0\n\uC54C\uB824\uC838 \uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879172
    m_Localized: "1. \uCCAD \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879173
    m_Localized: "2. \uCC28 \uB053\uC774\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879174
    m_Localized: "3. \uCC28 \uC644\uC131\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879175
    m_Localized: "\uC218\uC815\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879176
    m_Localized: "\u2018\uB9D1\uC740 \uACFC\uC77C \uC74C\uB8CC\u2019\uB780 \uB73B\uC73C\uB85C,\n\uC608\uB85C\uBD80\uD130
      \uBAB8\uC744 \uB530\uB73B\uD558\uAC8C \uD558\uACE0\n\uC18C\uD654\uB97C \uB3D5\uB294
      \uD6A8\uB2A5\uC774 \uC788\uC5B4\n\uADC0\uD55C \uC190\uB2D8 \uC811\uB300 \uB0A0
      \uD6C4\uC2DD\uC73C\uB85C \uC990\uACA8 \uBA39\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879177
    m_Localized: "1. \uCC28 \uB053\uC774\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879178
    m_Localized: "2. \uB9C8\uBB34\uB9AC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879179
    m_Localized: "\uAE30\uBCF8 \uC870\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879180
    m_Localized: "\uC704, \uC67C\uCABD, \uC544\uB798, \uC624\uB978\uCABD \uC774\uB3D9\uC774
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879181
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uAC00 \uC544\uC774\uD15C\uC744 \uC7A1\uACE0,\n\uD55C\uBC88
      \uB354 \uB204\uB974\uBA74 \uB0B4\uB824\uB193\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879182
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC \uC548\uC758 \uBB3C\uAC74\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879183
    m_Localized: "\uB18D\uC791\uBB3C \uC218\uD655 \uC2DC \uC6B0\uD074\uB9AD \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879184
    m_Localized: "\uB18D\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879185
    m_Localized: "1. \uC0C1\uC790\uB97C \uC5F4\uC5B4 \uBC2D\uC5D0 \uC2EC\uC744 \uC7AC\uB8CC\uB97C\n\uAEBC\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879186
    m_Localized: "2. \uC7AC\uB8CC\uB97C \uB4E4\uACE0 \uC2EC\uC744 \uC704\uCE58\uC758
      \uBC2D\uC744 \uC6B0\uD074\uB9AD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879187
    m_Localized: "3. \uBB3C\uBFCC\uB9AC\uAC1C\uB97C \uB4E4\uACE0 \uBC2D\uC744 \uD074\uB9AD\uD574
      \uBB3C\uC744 \uC8FC\uBA74\n\uC791\uBB3C\uC774 \uCD1D 3\uB2E8\uACC4\uC5D0 \uAC78\uCCD0
      \uC790\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879188
    m_Localized: "4. \uB2E4 \uC790\uB780 \uC791\uBB3C\uC744 \uC218\uD655\uD569\uB2C8\uB2E4.\n\uC218\uD655\uD55C
      \uC7AC\uB8CC\uB294 '\uC7AC\uACE0'\uC5D0\uC11C \uD655\uC778\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879189
    m_Localized: "\uB2E4\uACFC \uC81C\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879190
    m_Localized: "1. \uC0C1\uC790\uB97C \uC5F4\uC5B4 \uD544\uC694\uD55C \uC7AC\uB8CC\uB97C
      \uAEBC\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879191
    m_Localized: "2. \uC6D0\uD558\uB294 \uB2E4\uACFC \uC81C\uC791\uC5D0 \uD544\uC694\uD55C
      \uC7AC\uB8CC\uB97C\n\uC54C\uB9DE\uC740 \uC81C\uC791\uB300\uC5D0 \uBAA8\uB450
      \uB123\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879192
    m_Localized: "3. \uC81C\uC791\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1678801879193
    m_Localized: "4. \uC644\uC131 \uB41C \uB2E4\uACFC\uB97C \uC190\uB2D8\uC5D0\uAC8C
      \uC81C\uACF5\uD558\uBA74,\n\uBCC4\uBE5B\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
