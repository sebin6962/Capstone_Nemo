  m_TableData:
  - m_Id: 226113077248
    m_Localized: "\uC61B\uB0A0 \uC61B\uC801, \uB2EC\uC5D0\uC11C \uD1A0\uB07C\uB4E4\uC774
      \uC808\uAD6C\uB97C \uCC27\uACE0 \uC788\uB2E4\uB294 \uC774\uC57C\uAE30\uB97C
      \uB4E4\uC5B4\uBCF8 \uC801 \uC788\uB098\uC694?||\uC0AC\uB78C\uB4E4\uC740 \uC804\uC124\uC774\uB77C
      \uBBFF\uC5C8\uC9C0\uB9CC, \uB2EC\uBE5B \uB108\uBA38\uC5D0\uB294 \uC815\uB9D0\uB85C
      <b><color=#FFF2B8><size=110%>\uD1A0\uB07C\uB4E4\uC758 \uC791\uC740 \uB9C8\uC744</size></color></b>\uC774
      \uC788\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 226180186112
    m_Localized: "\uC2DC\uAC04\uC774 \uD750\uB97C\uC218\uB85D \uB354 \uB9CE\uC740
      \uD1A0\uB07C\uB4E4\uC774 \uC774\uACF3\uC5D0 \uBAA8\uC5EC\uB4E4\uC5B4 \uAC00\uC871\uC744
      \uC774\uB8E8\uC5C8\uACE0, \uC791\uC740 \uB9C8\uC744\uB3C4 \uC870\uAE08\uC529
      \uC790\uB77C\uB0AC\uC2B5\uB2C8\uB2E4.||\uC138\uC6D4\uC774 \uD750\uB974\uBA74\uC11C,
      \uD1A0\uB07C\uB4E4\uC774 \uD558\uB294 \uC77C\uB3C4 \uD558\uB098\uB458\uC529
      \uB2E4\uC591\uD574\uC9C0\uAE30 \uC2DC\uC791\uD588\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 226180186113
    m_Localized: "\uADF8\uB7F0\uB370 \uC5B4\uB290 \uB0A0\uBD80\uD130, \uBE5B\uC744
      \uBA38\uAE08\uACE0 \uC788\uB358  <b><color=#CDEFFF><size=110%>\uACC4\uC218\uB098\uBB34</size></color></b>\uAC00
      \uC870\uAE08\uC529 \uC2DC\uB4E4\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4.||\uC815\uC131\uAECF
      \uC88B\uC740 \uBE44\uB8CC\uB97C \uBFCC\uB9AC\uACE0, \uAC04\uC808\uD55C \uB9C8\uC74C\uC73C\uB85C
      \uD558\uB298\uC5D0 \uAE30\uB3C4\uB97C \uB4DC\uB824 \uBCF4\uC544\uB3C4 \uC544\uBB34
      \uC18C\uC6A9\uC774 \uC5C6\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 226180186114
    m_Localized: "\uC774\uB300\uB85C \uB450\uC5C8\uB2E4\uAC00\uB294 \uACC4\uC218\uB098\uBB34\uB3C4,
      \uD1A0\uB07C\uB4E4\uC774 \uC0B4\uC544\uAC00\uB358 \uB2EC\uB9C8\uC744\uB3C4
      \uD568\uAED8 \uC2DC\uB4E4\uC5B4 \uBC84\uB9B4\uC9C0 \uBAB0\uB790\uC5B4\uC694.||\uBAA8\uB450\uAC00
      \uBD88\uC548\uC5D0 \uC7A0\uAE34 \uADF8\uB54C, <b><color=#FFF2B8>\uD55C \uD1A0\uB07C\uAC00
      \uAC00\uB9CC\uD788 \uC0DD\uAC01\uC5D0 \uC7A0\uACBC\uC2B5\uB2C8\uB2E4.</color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 226180186115
    m_Localized: "\uACE0\uBBFC\uD558\uB358 \uD1A0\uB07C\uC5D0\uAC8C\uB294 \uD55C
      \uAC00\uC9C0 \uD2B9\uBCC4\uD55C \uC7AC\uC8FC\uAC00 \uC788\uC5C8\uC5B4\uC694.||\uBC14\uB85C
      \uBA40\uACE0 \uBA3C \uC9C0\uAD6C\uBCC4\uC758 \uC791\uC740 \uB098\uB77C, <b><color=#FFF2B8><size=110%>\uD55C\uAD6D\uC758
      \uC804\uD1B5 \uB2E4\uACFC</size></color></b>\uB97C \uB9CC\uB4DC\uB294 \uC77C\uC774\uC5C8\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 226180186116
    m_Localized: "\uC21C\uAC04, \uD1A0\uB07C\uC758 \uBA38\uB9BF\uC18D\uC5D0 \uBC18\uC9DD\uC774\uB294
      \uC0DD\uAC01 \uD558\uB098\uAC00 \uB5A0\uC62C\uB790\uC5B4\uC694.||<b><color=#CDEFFF><size=115%>\u201C\uBCC4\uBE5B\uC744
      \uD654\uD3D0\uB85C \uC4F0\uB294 \uC678\uACC4\uC778\uB4E4\uC5D0\uAC8C \uB2E4\uACFC\uB97C
      \uD314\uC544 \uBCF4\uBA74 \uC5B4\uB5A8\uAE4C?\u201D</size></color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 226180186117
    m_Localized: "\uADF8\uB807\uAC8C \uD1A0\uB07C\uB294 \uD55C\uAD6D \uC804\uD1B5
      \uB2E4\uACFC\uB97C \uD310\uB9E4\uD558\uB294 \uC791\uC740 \uB2E4\uACFC\uC810,
      <b><color=#FFF2B8><size=110%>\u2018\uB2EC\uB2E4\uB2F4\u2019</size></color></b>\uC758
      \uBB38\uC744 \uC5F4\uAE30\uB85C \uD588\uB2F5\uB2C8\uB2E4.||\uACFC\uC5F0 \uD1A0\uB07C\uB294
      \uB2E4\uACFC\uB97C \uD314\uC544 \uBAA8\uC740 \uBCC4\uBE5B\uC73C\uB85C, \uACC4\uC218\uB098\uBB34\uC640
      \uB2EC\uB9C8\uC744\uC744 \uB2E4\uC2DC \uB418\uC0B4\uB9B4 \uC218 \uC788\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
