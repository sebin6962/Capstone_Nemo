  fixedVillageTutorialPanels: {fileID: 1923840158}
  villageFirstStartDialogues:
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uACE0\uC0DD \uB9CE\uC558\uB2E4.\n\uC81C\uBC95 \uBC88\uB4EF\uD55C
      \uAC00\uAC8C\uB97C \uCC28\uB824\uB0C8\uAD6C\uB098."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uB9AC\uBAA8\uB378\uB9C1\uC744 \uB9E1\uAE34 \uD1A0\uB07C\uAC00 \uC19C\uC528\uAC00
      \uC88B\uAE30\uB85C \uC18C\uBB38\uB09C\n\uC804\uBB38\uAC00\uB77C\uB354\uB2C8,
      \uD5C8\uC5B8\uC740 \uC544\uB2C8\uC5C8\uB098\uBCF4\uAD6C\uB098.\n\uAC00\uAC8C
      \uC678\uBD80\uAC00 \uAF64 \uADFC\uC0AC\uD55C\uB370."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC11C \uAD6C\uACBD \uD55C\uBC88
      \uC2DC\uCF1C\uC8FC\uACA0\uB2C8?"
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  afterGoToFieldDialogues:
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uBC2D\uB3C4 \uC81C\uBC95 \uD130\uB97C \uC798 \uC7A1\uC558\uAD6C\uB098!\n\uB545
      \uAE30\uC6B4\uC774 \uC88B\uC544 \uBCF4\uC5EC \uB2E4\uD589\uC774\uC57C."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uCC38, \uC694\uC998 \uB9C8\uC744 \uC190\uB2D8\uB4E4\uC774 \uB2E8\uD638\uBC15
      \uC124\uAE30\uB97C \uADF8\uB807\uAC8C \uCC3E\uB294\uB2E4\uB354\uAD6C\uB098.\n\uBBF8\uB9AC
      \uB2E8\uD638\uBC15\uC744 \uB109\uB109\uD788 \uC218\uD655\uD574 \uB450\uC5B4\uC57C
      \uD558\uC9C0 \uC54A\uACA0\uB2C8?"
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  afterHarvestDialogues:
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uC88B\uC544, \uC218\uD655\uAE4C\uC9C0 \uCC99\uCC99 \uD574\uB0B4\uB294
      \uAC78 \uBCF4\uB2C8 \uB9C8\uC74C\uC774 \uB193\uC774\uB294\uAD6C\uB098.\n\uD558\uC9C0\uB9CC
      \uC218\uD655\uC774 \uB05D\uC774 \uC544\uB2C8\uB780\uB2E4."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uB2E8\uD638\uBC15\uC744 \uAC00\uB8E8\uB85C \uB9CC\uB4E4\uC5B4 \uBC18\uC8FD\uC5D0
      \uC11E\uC5B4\uC57C \uC9C4\uC815\uD55C \uB9DB\uC774 \uC6B0\uB7EC\uB098\uB294
      \uBC95\uC778\uB370,\n\uADF8 \uBC29\uBC95\uC740 \uC78A\uC9C0 \uC54A\uC558\uACA0\uC9C0?"
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uBC29\uC557\uAC04\uC5D0 \uAC00\uC11C \uAC00\uB8E8\uB85C \uBC14\uAFB8\uB294
      \uBC95\uB3C4 \uB2E4\uC2DC \uC775\uD790 \uACB8, \uD568\uAED8 \uAC00\uBCF4\uC790\uAFB8\uB098.
      \n\uBC1C\uAC78\uC74C\uC744 \uC11C\uB458\uB7EC\uC57C\uACA0\uC5B4."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  IsVillageSecondTutorialRunning: 1
