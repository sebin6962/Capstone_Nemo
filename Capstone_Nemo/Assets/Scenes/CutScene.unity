  - {fileID: 1198673619}
  fadeImage: {fileID: 33507983}
  panelHoldSeconds: 4
  fadeSeconds: 1.5
  cutSceneDuration: 13.5
  subtitles:
  - content: "\uC544\uC8FC \uBA3C \uC61B\uB0A0\uBD80\uD130, \uB2EC\uC5D0\uB294 \uD1A0\uB07C\uB4E4\uC774
      \uC0B4\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
  - content: "\uC2DC\uAC04\uC774 \uC9C0\uB0A0 \uC218\uB85D \uB354 \uB9CE\uC740 \uD1A0\uB07C\uB4E4\uC774
      \uBAA8\uC5EC \uAC00\uC871\uC744 \uAFB8\uB9AC\uACE0, \uB9C8\uC744\uC744 \uB9CC\uB4E4\uC5C8\uC5B4\uC694.||\r\n\uB2EC\uD1A0\uB07C
      \uB9C8\uC744\uC758 \uCEE4\uB2E4\uB780 \uACC4\uC218\uB098\uBB34\uB294 \uD1A0\uB07C\uB4E4\uC5D0\uAC8C
      \uC7AC\uD654\uB85C \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uBCC4\uBE5B\uC744
      \uC81C\uACF5\uD574\uC8FC\uC5C8\uC9C0\uC694."
  - content: "\uADF8\uB7F0\uB370 \uC5B4\uB290 \uB0A0\uBD80\uD130 \uACC4\uC218\uB098\uBB34\uB294
      \uBE5B\uC744 \uC783\uC5B4\uAC00\uACE0, \uC2DC\uB4E4\uC5B4\uAC00\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4.||\n\uC88B\uC740
      \uBE44\uB8CC\uB97C \uBFCC\uB9AC\uACE0, \uD558\uB298\uC5D0 \uAE30\uB3C4\uB97C
      \uB4DC\uB824\uB3C4 \uC18C\uC6A9\uC774 \uC5C6\uC5C8\uC5B4\uC694."
  - content: "\uC774\uB300\uB85C\uB294 \uACC4\uC218\uB098\uBB34\uC640 \uD568\uAED8
      \uB2EC\uD1A0\uB07C \uB9C8\uC744\uC5D0\uB3C4 \uC704\uAE30\uAC00 \uCC3E\uC544\uC62C
      \uAC83\uC774 \uBD84\uBA85\uD588\uC8E0.||\r\n\uB9C8\uC744\uC758 \uD55C \uD1A0\uB07C\uB294
      \uACE0\uBBFC\uC5D0 \uBE60\uC84C\uC2B5\uB2C8\uB2E4."
  - content: "\uD55C\uCC38 \uB4A4, \uD1A0\uB07C\uB294 \uD55C \uAC00\uC9C0 \uC544\uC774\uB514\uC5B4\uB97C
      \uB5A0\uC62C\uB838\uC2B5\uB2C8\uB2E4.||\r\n\uD55C\uAD6D \uC804\uD1B5 \uB2E4\uACFC\uB97C
      \uB9CC\uB4E4\uB358 \uCDE8\uBBF8\uB97C \uC0B4\uB824, \uC678\uACC4\uC778 \uC190\uB2D8\uB4E4\uC5D0\uAC8C
      \uBCC4\uBE5B\uC744 \uBC1B\uACE0 \uD30C\uB294 \uAC74 \uC5B4\uB5A8\uAE4C?"
  - content: "\uADF8\uB807\uAC8C \uD1A0\uB07C\uB294 \uD55C\uAD6D \uC804\uD1B5 \uB2E4\uACFC\uB97C
      \uD310\uB9E4\uD558\uB294 \uAC00\uAC8C, \u2018\uB2EC\uB2E4\uB2F4'\uC744 \uC6B4\uC601\uD558\uAE30\uB85C
      \uACB0\uC2EC\uD558\uB294\uB370... ||\r\n\uACFC\uC5F0 \uD1A0\uB07C\uB294 \uBB34\uC0AC\uD788
      \uACC4\uC218\uB098\uBB34\uB97C \uC0B4\uB9B4 \uC218 \uC788\uC744\uAE4C\uC694?"
  subtitleContainer: {fileID: 1244207705}
  subtitleLinePrefab: {fileID: 3207494433359376507, guid: 53e408f211f9d3348b2c95e325c3c33a, type: 3}
  subtitleGroup: {fileID: 0}
  lineSpacingPx: 18
