    dialogue: "(\uB9D0\uC5C6\uC774 \uACE0\uAC1C\uB97C \uAFB8\uBC85 \uC219\uC778\uB2E4.)"
    portrait: {fileID: 21300000, guid: f28a5501c2164c3458e6bd9f3db4a7ae, type: 3}
  - speakerName: "\uC724\uC2AC"
    dialogue: "\uC5B4\uBA38, \uB2E8\uD638\uBC15\uC744 \uB4E4\uACE0 \uC624\uC2E0 \uAC78
      \uBCF4\uB2C8 \uAC00\uB8E8\uB85C \uBC14\uAFB8\uB7EC \uC624\uC168\uB098 \uBCF4\uB124\uC694!
      \n\uAC00\uB78C\uC544, \uC0AC\uC7A5\uB2D8 \uB3C4\uC640\uB4DC\uB824\uC57C\uC9C0!"
    portrait: {fileID: 21300000, guid: d048fbd7569a1fe4390464ab779f87a0, type: 3}
  - speakerName: "\uAC00\uB78C"
    dialogue: "...(\uCC9C\uCC9C\uD788 \uC808\uAD6C \uCABD\uC744 \uAC00\uB9AC\uD0A4\uBA70
      \uACE0\uAC1C\uB97C \uAE4C\uB2E5\uC778\uB2E4.)"
    portrait: {fileID: 21300000, guid: f28a5501c2164c3458e6bd9f3db4a7ae, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uC800 \uCE5C\uAD6C\uAC00 \uC544\uC8FC \uC19C\uC528\uAC00 \uC88B\uB2E4\uACE0
      \uD558\uB354\uAD6C\uB098. \n\uC5B4\uC11C \uC808\uAD6C \uC55E\uC73C\uB85C \uAC00\uBCF4\uB834."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  afterTalkToNpcDialogues:
  - speakerName: "\uAC00\uB78C"
    dialogue: "..\uC8FC\uC2DC\uBA74, ...\uAC00\uB8E8\uB85C... \uBC14\uAFD4, \uB4DC\uB9B4\uAC8C\uC694."
    portrait: {fileID: 21300000, guid: f28a5501c2164c3458e6bd9f3db4a7ae, type: 3}
  afterGrindDialogues:
  - speakerName: "\uAC00\uB78C"
    dialogue: "\uB2E4, \uB410\uC2B5\uB2C8\uB2E4..."
    portrait: {fileID: 21300000, guid: f28a5501c2164c3458e6bd9f3db4a7ae, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uC5B4\uB514 \uBCF4\uC790... \n\uC74C, \uC544\uC8FC \uACF1\uAC8C \uC798
      \uAC08\uB838\uAD6C\uB098. \uC88B\uB2E4."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uAC00\uB78C\uC774 \uB140\uC11D\uC758 \uC19C\uC528\uB294 \uD22C\uBC15\uD574\uB3C4
      \uACB0\uACFC\uBB3C\uC740 \uB298 \uBBFF\uC74C\uC9C1\uD574. \n\uC124\uAE30 \uB9CC\uB4E4\uAE30\uC5D0
      \uB531 \uC54C\uB9DE\uC740 \uC785\uC790\uAD6C\uB098."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uCC38. \uC774 \uBC29\uC557\uAC04\uC5D0\uC11C\uB294 \uAC00\uB8E8 \uAC00\uACF5\uC744
      \uD574\uC904 \uBFD0\uB9CC \uC544\uB2C8\uB77C, \n\uC724\uC2AC\uC774 \uB140\uC11D\uC774
      \uB2E4\uACFC\uB97C \uB9CC\uB4E4 \uB54C \uD544\uC694\uD55C \uB2E4\uC591\uD55C
      \uC7AC\uB8CC\uB97C \uD310\uB2E4\uACE0 \uD558\uB354\uAD6C\uB098."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uD55C\uBC88 \uC724\uC2AC\uC774\uD55C\uD14C\uB3C4 \uAC00\uBCF4\uC9C0
      \uC54A\uC73C\uB828?"
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  afterOpenStoreDialogues:
  - speakerName: "\uC724\uC2AC"
    dialogue: "\uC5B4\uC11C\uC624\uC138\uC694! \uC0AC\uC7A5\uB2D8. \n\uB2E4\uACFC
      \uB9CC\uB4DC\uB294\uB370\uC5D0\uB294 \uC5ED\uC2DC \uBC29\uC557\uAC04\uC5D0\uC11C
      \uD30C\uB294 \uAC83 \uB9CC\uD55C\uAC8C \uC5C6\uC8E0!"
    portrait: {fileID: 21300000, guid: d048fbd7569a1fe4390464ab779f87a0, type: 3}
  - speakerName: "\uC724\uC2AC"
    dialogue: "\uCC39\uC300\uAC00\uB8E8, \uCF69\uAC00\uB8E8, \uC5FF\uAE30\uB984..
      \uD30C\uB294\uAC8C \uC815\uB9D0 \uB9CE\uC740\uB370! \n\uC624\uB298\uC740 \uBB3C\uD488\uC774
      \uB4E4\uC5B4\uC624\uB294 \uB0A0\uC774 \uC544\uB2C8\uB77C\uC11C \uBCF4\uC5EC\uB4DC\uB9B4
      \uC218\uAC00 \uC5C6\uB124\uC694."
    portrait: {fileID: 21300000, guid: d048fbd7569a1fe4390464ab779f87a0, type: 3}
  - speakerName: "\uC724\uC2AC"
    dialogue: "\uB2E4\uC74C\uC5D0 \uD544\uC694\uD55C\uAC8C \uC788\uC73C\uC2E4 \uB54C
      \uC624\uC2DC\uBA74 \n\uAF2D \uCC3E\uC544\uAC00\uC2E4 \uC218 \uC788\uB3C4\uB85D
      \uB9C8\uB828\uD574\uB193\uC744\uAC8C\uC694 ~!"
    portrait: {fileID: 21300000, guid: d048fbd7569a1fe4390464ab779f87a0, type: 3}
  - speakerName: "\uC724\uC2AC"
    dialogue: "\uC800\uD55C\uD14C \uC5B8\uC81C\uB4E0 \uB9D0\uB9CC \uAC78\uC5B4\uC8FC\uC2DC\uBA74
      \uB3FC\uC694!"
    portrait: {fileID: 21300000, guid: d048fbd7569a1fe4390464ab779f87a0, type: 3}
  afterQuitStoreDialogues:
  - speakerName: "\uB4E0\uD574"
    dialogue: "\uC790. \uC774\uC81C \uB2E8\uD638\uBC15\uB3C4 \uAC00\uB8E8\uB85C \uACF1\uAC8C
      \uB9CC\uB4E4\uC5C8\uC73C\uB2C8, \n\uB2E8\uD638\uBC15 \uC124\uAE30\uB97C \uB9CC\uB4E4\uB7EC
      \uAC00\uAC8C\uB85C \uB2E4\uC2DC \uB3CC\uC544\uAC00\uC790\uAFB8\uB098."
    portrait: {fileID: 21300000, guid: 6192a9ec3cbad8e46a24408052383252, type: 3}
  millTutorialPanel: {fileID: 28357626}
  currentStep: 0
  IsMillTutorialRunning: 0
